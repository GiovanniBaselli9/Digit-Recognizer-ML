# Performance monitoring decorator
def time_it(func):
    @wraps(func)
    def wrapper(*args, **kwargs):
        start = time.time()
        result = func(*args, **kwargs)
        end = time.time()
        print(f"{func.__name__} completed in {end - start:.2f} seconds")
        return result
    return wrapper

# Memory management helper
def clear_memory():
    """Clear memory and run garbage collection"""
    gc.collect()
    if tf.test.is_gpu_available():
        tf.keras.backend.clear_session()

# Data loading with caching
class DataLoader:
    def __init__(self, cache_dir="cache"):
        self.cache_dir = Path(cache_dir)
        self.cache_dir.mkdir(exist_ok=True)
        
    @time_it
    def load_and_preprocess_data(self, train_path, test_path, force_reload=False):
        """Load and preprocess data with caching for faster subsequent loads"""
        cache_file = self.cache_dir / "preprocessed_data.joblib"
        
        if cache_file.exists() and not force_reload:
            print("Loading cached preprocessed data...")
            return joblib.load(cache_file)
        
        print("Loading and preprocessing data...")
        
        # Load data efficiently
        train_data = pd.read_csv(train_path)
        test_data = pd.read_csv(test_path)
        
        # Separate features and target
        y = train_data['label'].values
        X_train_full = train_data.drop('label', axis=1).values
        X_test = test_data.values
        
        # Normalize data (more memory efficient than division)
        X_train_full = X_train_full.astype(np.float32) / 255.0
        X_test = X_test.astype(np.float32) / 255.0
        
        # Remove duplicates efficiently
        unique_indices = self._get_unique_indices(X_train_full)
        X_train_full = X_train_full[unique_indices]
        y = y[unique_indices]
        
        # Split data
        X_train, X_val, y_train, y_val = train_test_split(
            X_train_full, y, test_size=0.2, random_state=42, stratify=y
        )
        
        # Standard scaling
        scaler = StandardScaler()
        X_train_scaled = scaler.fit_transform(X_train)
        X_val_scaled = scaler.transform(X_val)
        X_test_scaled = scaler.transform(X_test)
        
        data = {
            'X_train': X_train_scaled.astype(np.float32),
            'X_val': X_val_scaled.astype(np.float32),
            'X_test': X_test_scaled.astype(np.float32),
            'y_train': y_train,
            'y_val': y_val,
            'X_train_raw': X_train,
            'X_val_raw': X_val,
            'X_test_raw': X_test,
            'scaler': scaler
        }
        
        # Cache the preprocessed data
        joblib.dump(data, cache_file, compress=3)
        print(f"Data cached to {cache_file}")
        
        return data
    
    def _get_unique_indices(self, X):
        """Efficiently find unique rows"""
        _, unique_indices = np.unique(X, axis=0, return_index=True)
        return np.sort(unique_indices)# Core imports with performance optimizations
